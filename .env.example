# ── Required ──────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Optional — needed for full feature set ────────────────────────────────────
APIFY_API_TOKEN=your_apify_token_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Gmail OAuth (run `python main.py auth` the first time) ────────────────────
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# ── Agent identity ────────────────────────────────────────────────────────────
SENDER_NAME=Your Name

# ── Targeting ─────────────────────────────────────────────────────────────────
# Comma-separated lists
TARGET_TITLES=VP of Sales,VP Sales,CRO,Chief Revenue Officer,Head of Sales,Director of Sales
TARGET_INDUSTRIES=
COMPETITOR_TECHNOLOGIES=salesforce,hubspot,outreach,salesloft
HIRING_DEPARTMENTS=sales,revenue,growth,business development

# ── Behavior ──────────────────────────────────────────────────────────────────
MAX_EMAILS_PER_RUN=10
DRY_RUN=false

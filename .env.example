# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Gmail OAuth (run `python main.py auth` once to create the token) ──────────
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# ── Hunter.io — recommended for reliable email discovery ──────────────────────
# Free tier: 25 searches/month  |  Sign up: https://hunter.io
# Without this key the agent relies on website scraping alone for emails.
HUNTER_API_KEY=your_hunter_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Agent identity ────────────────────────────────────────────────────────────
SENDER_NAME=Your Name

# ── Behaviour ─────────────────────────────────────────────────────────────────
MAX_EMAILS_PER_RUN=25
DRY_RUN=false
RECONTACT_TTL_DAYS=90

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=.agent_state/sent_log.csv

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Gmail OAuth (run `python main.py auth` once to create the token) ──────────
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# ── Apollo.io — primary contact discovery ─────────────────────────────────────
# Dashboard → Settings → Integrations → API  (copy the key, not the endpoint URL)
APOLLO_API_KEY=your_apollo_api_key_here

# ── LeadIQ — email enrichment ─────────────────────────────────────────────────
# Dashboard → Settings → API Keys
LEADIQ_API_KEY=your_leadiq_api_key_here

# ── Optional Slack notifications ──────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Agent identity ────────────────────────────────────────────────────────────
SENDER_NAME=Your Name

# ── Behaviour ─────────────────────────────────────────────────────────────────
MAX_EMAILS_PER_RUN=25
DRY_RUN=false
RECONTACT_TTL_DAYS=90

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=.agent_state/sent_log.csv
